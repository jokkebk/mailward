GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4873/auth/callback

# Jev assessments through TypeSafe's direct API. Required to check unread mail.
TYPESAFE_API_KEY=your_typesafe_api_key_here

DATABASE_PATH=./data/emails.db

# Zone for judging deadlines and event times (IANA name). Defaults to the system zone.
# MAILWARD_TIME_ZONE=Europe/Helsinki
