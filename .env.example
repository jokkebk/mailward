GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4873/auth/callback

# Daily triage classifier (AI tier). Provider behind a swappable interface.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0

# Alternative provider: set AI_PROVIDER=openai to use these instead.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
# none | minimal | low | medium | high | xhigh | max — support varies by model.
# gpt-5.6-luna accepts none/low/medium/high/xhigh/max (no 'minimal'). Blank = model default (medium).
OPENAI_REASONING_EFFORT=low

DATABASE_PATH=./data/emails.db
